# Where the mobile app finds the Go Interview API.
# Web builds served by the API host can leave this unset (same origin).
# iOS simulator:     http://localhost:8080
# Android emulator:  http://10.0.2.2:8080
# Real phone:        http://<your-computer-LAN-IP>:8080, or your deployed https URL
EXPO_PUBLIC_API_URL=http://localhost:8080
