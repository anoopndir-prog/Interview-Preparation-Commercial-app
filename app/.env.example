# Where the mobile app finds the Go Interview API.
# Web builds served by the API host can leave this unset (same origin).
# iOS simulator:     http://localhost:8080
# Android emulator:  http://10.0.2.2:8080
# Real phone:        http://<your-computer-LAN-IP>:8080, or your deployed https URL
EXPO_PUBLIC_API_URL=http://localhost:8080

# Google sign-in (Google Cloud Console → APIs & Services → Credentials).
# The Web client ID is used on every platform (it is the ID token's audience);
# the iOS client ID is also needed on iOS. Leave blank to hide the Google button.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
