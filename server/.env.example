# Claude API key from https://console.anthropic.com (the app's own key — users never see it)
ANTHROPIC_API_KEY=

# Long random string used to sign session tokens. REQUIRED in production.
JWT_SECRET=

PORT=8080
DB_PATH=./data/go-interview.db

# Timezone for the 6:00 AM daily news refresh
NEWS_TIMEZONE=Asia/Kolkata

# Built web app (npm run build:web in ../app) served from the same host
WEB_DIST_DIR=../app/dist

# Comma-separated browser origins allowed to call the API (mobile apps don't need this)
CORS_ORIGINS=http://localhost:8081

# DEV ONLY: prints sign-in codes to the console and enables /api/billing/dev-upgrade.
DEV_AUTH=true

# Email delivery for sign-in codes in production (https://resend.com)
RESEND_API_KEY=
EMAIL_FROM=Go Interview <login@example.com>

# Shared secret configured in the RevenueCat webhook "Authorization" header
REVENUECAT_WEBHOOK_SECRET=
