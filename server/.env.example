# AI provider: gemini, groq or anthropic. Leave blank to use whichever key below is set
# (checked in that order). These are the app's own keys — users never see them.
AI_PROVIDER=
# Optional model override. Defaults: gemini-3.8-flash · openai/gpt-oss-120b · claude-opus-5
AI_MODEL=

# Google Gemini key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Groq key from https://console.groq.com/keys
GROQ_API_KEY=
# Claude key from https://console.anthropic.com
ANTHROPIC_API_KEY=

# Long random string used to sign session tokens. REQUIRED in production.
JWT_SECRET=

PORT=8080
DB_PATH=./data/go-interview.db

# Built web app (npm run build:web in ../app) served from the same host
WEB_DIST_DIR=../app/dist

# Comma-separated browser origins allowed to call the API (mobile apps don't need this)
CORS_ORIGINS=http://localhost:8081

# DEV ONLY: prints sign-in codes to the console and enables /api/billing/dev-upgrade.
DEV_AUTH=true

# Email delivery for sign-in codes in production (https://resend.com)
RESEND_API_KEY=
EMAIL_FROM=Go Interview <login@example.com>

# Google sign-in: comma-separated OAuth client IDs from Google Cloud Console
# (Web client ID first; add the iOS and Android client IDs too)
GOOGLE_CLIENT_IDS=

# Apple sign-in: the iOS bundle ID (plus a Services ID if Apple sign-in is added to the website)
APPLE_AUDIENCES=com.gointerview.app

# Shared secret configured in the RevenueCat webhook "Authorization" header
REVENUECAT_WEBHOOK_SECRET=
